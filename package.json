{
  "name": "skill-capsule",
  "version": "1.0.0",
  "description": "Portable, atomic, executable skill framework for AI coding agents.",
  "main": "dist/index.js",
  "bin": {
    "skillcap": "bin/skillcap.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:stdio": "node dist/stdio.js",
    "docker:build:hook-runner": "docker build -f Dockerfile.hook-runner -t skillcapsule/hook-runner:local .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "test:container": "npm run build && node --test test/container.test.js"
  },
  "keywords": [
    "mcp",
    "ai",
    "agent",
    "skills",
    "coding"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "fs-extra": "^11.3.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
