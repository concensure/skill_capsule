{
  "id": "github.upload.safety",
  "version": "1.0.0",
  "contract": {
    "requires_context": ["git.status"],
    "side_effects": "read_only",
    "guarantees": ["no_secrets_pushed"]
  },
  "source": {
    "file": "skills/domains/github.md",
    "section_id": "github-upload-safety"
  },
  "locs_level": 1,
  "capability_id": "github.publish.preflight",
  "triggers": {
    "keywords": ["github", "push", "upload"],
    "task_types": ["publish"],
    "blocked_by_intents": ["no_safety_checks"]
  },
  "activation_mode": "inspect",
  "hooks": [
    { "id": "hook.git.status", "phase": "before_render" },
    { "id": "hook.secrets.scan", "phase": "before_action", "blocks_on_fail": true }
  ],
  "locs_capsule": {
    "capability_id": "github.publish.preflight",
    "capability_name": "GitHub Publish Preflight",
    "capability_summary": "Verify repository safety signals before a GitHub publish or push operation.",
    "state_model": "external-boundary",
    "side_effects": "read-only",
    "determinism": "deterministic-if-environment-stable",
    "risk_level": "medium",
    "approval_policy": "auto-if-readonly",
    "audit_level": "standard",
    "swappable_atom_group": "github-publish-preflight",
    "compatibility": ["git", "github"],
    "success_evidence": ["git_status_collected", "secret_scan_passed"]
  },
  "render": {
    "S": "Before GitHub upload: check secrets and git status.",
    "O": "Run secret scan and inspect git status before pushing to origin. Outcome: {{HOOK_RESULTS}}",
    "X": "CRITICAL: You must verify that no sensitive files or API keys are staged. Results: {{HOOK_RESULTS}}"
  },
  "token_estimate": { "S": 20, "O": 50, "X": 100 }
}
